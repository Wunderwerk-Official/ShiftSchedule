DOMAIN=schedule.example.com
LETSENCRYPT_EMAIL=admin@example.com
ADMIN_USERNAME=admin
# REPLACE both placeholders below before the first start. The backend accepts
# any non-empty JWT_SECRET in production, and this repository is public.
ADMIN_PASSWORD=choose-a-strong-password
# Generate with e.g.: openssl rand -base64 48
JWT_SECRET=change-me-too
# Must not be empty: docker-compose.yml and docker-compose.ip.yml pass it
# through without a default.
JWT_EXPIRE_MINUTES=720
# The backend never loads this file itself (no dotenv); only docker compose
# reads it. For a local uvicorn run, export variables in the shell instead.
#
# Optional: used to build public iCal subscription URLs. Read by
# docker-compose.ip.yml (IP-only: http://SERVER_IP:8000);
# docker-compose.yml and docker-compose.proxied.yml set https://${DOMAIN}/api.
PUBLIC_BASE_URL=
# Optional: frontend base URL used for PDF rendering (Playwright). Ignored by
# the compose files (domain stack: https://${DOMAIN}; IP-only: APP_ORIGIN; proxied: the
# internal http://frontend, override via FRONTEND_INTERNAL_URL). For local
# runs, export it in the shell; this line is read by nothing.
FRONTEND_BASE_URL=

# --- Agent solver (optional; only needed for solver_mode="agent") ---
# Everything here can also be set at runtime by an admin in Settings ->
# Solver; values stored there override these env defaults.
# API key for the Anthropic provider. Without it, agent runs fall back to the
# heuristic seed plan with an explanatory note.
ANTHROPIC_API_KEY=
# anthropic | openai (OpenAI-compatible, e.g. self-hosted vLLM) | mock (tests)
AGENT_PROVIDER=anthropic
# Anthropic model id; ignored when the admin picked one in Settings.
AGENT_MODEL=claude-sonnet-5
# OpenAI-compatible endpoint (AGENT_PROVIDER=openai), e.g. a self-hosted vLLM:
#   OPENAI_BASE_URL=http://10.0.0.5:8000/v1
# Most self-hosted servers ignore the key; leave empty unless yours checks it.
# OPENAI_BASE_URL=
# OPENAI_API_KEY=
# Set to false ONLY for self-signed certificates on a trusted internal net.
# OPENAI_VERIFY_TLS=true
# IGNORED since v1.64 (no longer read; the compose files still pass it,
# harmlessly): the iteration budget is computed per solve as total slot
# instances x 10 (see backend/agent/harness.py); there is no wall-clock
# limit unless the request sets timeout_seconds (the UI never does).
# AGENT_MAX_ITERATIONS=20
# AGENT_MAX_TOKENS=8000
# Tests only: path to a scripted mock-provider JSON (AGENT_PROVIDER=mock).
# AGENT_MOCK_SCRIPT=
